{
  "name": "@rayscale/types",
  "description": "Type definitions for the Rayscale ecosystem.",
  "version": "1.0.2",
  "exports": "./source/index.ts",
  "publish": {
    "include": [
      "source/**/*.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "minimumDependencyAge": "0",
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "include": ["source/"]
  },
  "tasks": {
    "quality-check": "deno fmt --check && deno lint && deno check"
  }
}
